# =============================================================
# BxTorneum — plantilla de entorno (PRODUCCIÓN)
# Copia este archivo a .env en el servidor y completa los
# valores marcados con  <<< COMPLETAR  (nunca commitees el .env real).
#   1) cp .env.example .env
#   2) php artisan key:generate        (genera APP_KEY)
#   3) rellena DB_PASSWORD con la clave real de la BD
#   4) php artisan migrate --force && php artisan db:seed --class=TeamSeeder --force
#   5) npm install && npm run build
# =============================================================

APP_NAME=BxTorneum
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://novacodefc.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de datos (MySQL — Hostinger) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u834187355_bxtorneum
DB_USERNAME=u834187355_adminbx
DB_PASSWORD=        # <<< COMPLETAR en el servidor (no commitear)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.novacodefc.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@novacodefc.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
