# =============================================================
# BxTorneum — plantilla de entorno (PRODUCCIÓN)
# Copia este archivo a .env en el servidor y completa los valores
# vacíos marcados con  "COMPLETAR"  abajo. Nunca commitees el .env real.
#
# Despliegue (Hostinger):
#   1) cp .env.example .env
#   2) composer install --no-dev --optimize-autoloader
#   3) php artisan key:generate            # genera APP_KEY
#   4) edita .env: pon DB_PASSWORD y REPORT_PASSWORD reales
#   5) php artisan migrate --force
#   6) php artisan db:seed --class=TeamSeeder --force   # equipos iniciales
#   7) npm install && npm run build
#   8) php artisan config:cache && php artisan route:cache && php artisan view:cache
#   El document root del dominio debe apuntar a la carpeta /public
# =============================================================

APP_NAME=BxTorneum
APP_ENV=production
# COMPLETAR con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://novacodefc.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de datos (MySQL — Hostinger) ---
# Si la conexión falla con 127.0.0.1, prueba DB_HOST=localhost
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u834187355_bxtorneum
DB_USERNAME=u834187355_adminbx
# COMPLETAR con la contraseña real de la base de datos
DB_PASSWORD=

# --- Reporte PDF ---
# COMPLETAR: contraseña única para descargar el PDF del torneo
REPORT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.novacodefc.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@novacodefc.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
